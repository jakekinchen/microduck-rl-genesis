{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "microduck.m5-experiment-contract/v1",
  "title": "MicroDuck M5 immutable cross-backend experiment contract",
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "state", "evidence_boundary",
    "blocking_gates", "repositories", "bindings", "training_config",
    "tasks", "evaluator", "decision_rules", "abort_criteria",
    "artifacts", "resumability", "resource_proposal"
  ],
  "properties": {
    "schema_version": {"const": "microduck.m5-experiment-contract/v1"},
    "state": {"const": "preregistered_blocked"},
    "evidence_boundary": {"const": "experiment_infrastructure_only"},
    "tasks": {"type": "array", "minItems": 2, "maxItems": 2},
    "blocking_gates": {"type": "array", "minItems": 3}
  },
  "additionalProperties": false
}
