    "same_evaluator_for_all_backends": true
  },
  "decision_rules": {
    "primary_endpoint": "frozen task-classifier pass fraction over every required held-out cell",
    "walking_noninferiority_margin_absolute": 0.05,
    "backflip_noninferiority_margin_absolute": 0.0,
    "confidence_rule": "paired seed-and-cell bootstrap, 10000 preregistered resamples; lower 95 percent confidence bound of Genesis minus official must be at least negative margin",
    "variance_rule": "report per-backend seed variance and ratio; Genesis variance may not exceed official variance by more than 0.02 absolute pass-fraction variance",
    "time_to_threshold": "first predetermined transition checkpoint whose frozen classifier passes; never interpolate or choose a late checkpoint",
    "ranking_consistency": "report Spearman correlation of backend rankings across all predetermined checkpoints; no replacement decision when undefined",
    "selection_rule": "Genesis remains primary only if both tasks satisfy noninferiority and no integrity, variance, or authority gate fails",
    "ppo_return_is_success": false
  },
  "abort_criteria": [
    "any bound source or artifact hash drifts",
    "official_policy_authority_missing remains unresolved at candidate admission",
    "CUDA container digest is absent or compute is not explicitly authorized",
    "seed sets overlap or a held-out seed is realized before candidate freeze",
    "transition budgets differ between backends",
    "a checkpoint or normalized ONNX export is missing, added late, or selected from outcomes",
    "any evaluator input is unbound or differs between backends",
    "NaN, Inf, corrupt checkpoint, irrecoverable receipt gap, or hardware/runtime integrity failure",
    "resource runtime or cost ceiling is reached before artifact recovery"
  ],
  "artifacts": {
