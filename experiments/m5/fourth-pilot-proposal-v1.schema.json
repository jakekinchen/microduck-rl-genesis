{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "microduck.m5-fourth-pilot-proposal/v1",
  "title": "MicroDuck proposed fourth CUDA pilot",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "state",
