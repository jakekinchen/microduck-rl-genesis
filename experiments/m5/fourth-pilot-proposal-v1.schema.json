    "authority": {
      "type": "object"
    },
    "catalog_snapshot": {
      "type": "object"
    },
    "container": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "workspace": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "preconditions_for_any_later_authorized_create": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "failure_receipt": {
      "type": "object"
    },
    "teardown": {
      "type": "object"
    },
    "prohibited": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true
    },
    "evidence_boundary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
