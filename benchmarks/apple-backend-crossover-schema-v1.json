{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "microduck.apple-backend-crossover-row/v1",
  "title": "MicroDuck Apple backend crossover row",
  "type": "object",
  "required": [
    "schema_version", "num_envs", "construction_s", "reset_s", "warmup_s",
    "iterations", "summary", "peak_rss_bytes", "unified_memory", "devices",
    "backend", "thermal_samples", "source", "machine", "packages",
    "termination_reason", "proof_class", "task_success", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "microduck.apple-backend-crossover-row/v1"},
    "num_envs": {"enum": [64, 128, 256, 512]},
    "iterations": {"type": "array", "minItems": 20, "maxItems": 20},
    "termination_reason": {"const": "completed"},
    "proof_class": {"const": "performance_characterization"},
    "task_success": {"const": "not_evaluated"}
  },
  "additionalProperties": true
}
